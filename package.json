{
  "name": "screen-kit",
  "version": "0.2.2",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "description": "Agent-operated product demo video, screenshot, and terminal recording pipeline with Remotion 4, Display P3, Gemini TTS, Shorts 9:16, and automated QA.",
  "homepage": "https://github.com/maxvyshniakov/screen-kit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxvyshniakov/screen-kit.git"
  },
  "bugs": {
    "url": "https://github.com/maxvyshniakov/screen-kit/issues"
  },
  "keywords": [
    "screen-recording",
    "product-demo",
    "demo-video",
    "remotion",
    "playwright",
    "ffmpeg",
    "display-p3",
    "ai-agents",
    "screenshots",
    "terminal-recording",
    "asciinema",
    "youtube-shorts",
    "gemini-tts",
    "whisper",
    "subtitles",
    "cli"
  ],
  "bin": {
    "screen-kit": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./assets": "./src/assets.mjs",
    "./browser": "./src/browser.mjs",
    "./take-browser": "./src/take-browser.mjs",
    "./images": "./src/images.mjs",
    "./catalog": "./src/catalog.mjs",
    "./audio-mix": "./src/audio-mix.mjs",
    "./narration": "./src/narration.mjs",
    "./publish": "./src/publish.mjs",
    "./review-video": "./src/review-video.mjs",
    "./render-timeline": "./src/render-timeline.mjs",
    "./terminal": "./src/terminal.mjs",
    "./timeline": "./src/timeline.mjs",
    "./video": "./src/video.mjs",
    "./package.json": "./package.json"
  },
  "files": ["src", "fonts", "tools/build-symbol-font.py", "LICENSE", "README.md"],
  "scripts": {
    "prepare": "package-kit hooks install",
    "test": "node --test --test-concurrency=4 test/*.test.mjs",
    "lint": "oxlint --config .oxlintrc.json src test tools scripts examples",
    "check:kit": "package-kit check",
    "check:changelogs": "package-kit check-changelogs",
    "verify": "package-kit verify",
    "release": "package-kit release",
    "release:publish": "package-kit publish"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.545",
    "@remotion/cli": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "@xterm/headless": "6.0.0",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@maxvyshniakov/package-kit": "1.0.1",
    "oxlint": "1.94.0"
  },
  "license": "MIT"
}
